<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ system splash screen.
      A pitch-black backdrop (matching the new launcher icon background) with the note mark
      lifted onto a brand-purple disc, so the splash reads as its own thing rather than a
      copy of the all-black app icon.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_disc</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
