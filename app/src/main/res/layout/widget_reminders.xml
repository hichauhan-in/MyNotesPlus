<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/reminders_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="@string/widget_reminders_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_reminders_title"
            android:textColor="#B7ADFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />

        <ImageView
            android:id="@+id/reminders_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="@string/widget_reminders_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/reminders_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_reminders_empty"
        android:textColor="#9A9AA8"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/reminders_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:scrollbars="none" />
</LinearLayout>
