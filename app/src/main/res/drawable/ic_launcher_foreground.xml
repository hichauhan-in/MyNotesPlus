<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shrunk + centred so the note sits comfortably inside the icon mask (and the splash disc)
         instead of filling the whole space. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.74"
        android:scaleY="0.74">

        <!-- Back sheet (peeking behind, top-right) -->
        <path
            android:pathData="M50,30 h24 a6,6 0 0 1 6,6 v30 a6,6 0 0 1 -6,6 h-24 a6,6 0 0 1 -6,-6 v-30 a6,6 0 0 1 6,-6 z"
            android:fillColor="#D9DBFB"
            android:fillAlpha="0.55" />

        <!-- Front sheet (primary, bottom-left) -->
        <path
            android:pathData="M34,38 h30 a7,7 0 0 1 7,7 v30 a7,7 0 0 1 -7,7 h-30 a7,7 0 0 1 -7,-7 v-30 a7,7 0 0 1 7,-7 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="27"
                    android:startY="38"
                    android:endX="71"
                    android:endY="82">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="1" android:color="#FFEEF0FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Title line (accent) -->
        <path
            android:pathData="M39,48 h17 a2.5,2.5 0 0 1 0,5 h-17 a2.5,2.5 0 0 1 0,-5 z"
            android:fillColor="#6D5EF6" />

        <!-- Text line -->
        <path
            android:pathData="M39,58 h24 a2,2 0 0 1 0,4 h-24 a2,2 0 0 1 0,-4 z"
            android:fillColor="#C7CBEE" />

        <!-- Check row -->
        <path
            android:pathData="M39.5,67.5 l3,3 l6,-7"
            android:strokeColor="#22C3A6"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M54,68 h9 a2,2 0 0 1 0,4 h-9 a2,2 0 0 1 0,-4 z"
            android:fillColor="#C7CBEE" />
    </group>
</vector>

